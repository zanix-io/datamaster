{
  "name": "@zanix/datamaster",
  "version": "1.9.1",
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true
  },
  "links": [],
  "lint": {
    "rules": {
      "tags": [
        "recommended",
        "jsr"
      ],
      "include": [
        "eqeqeq",
        "default-param-last",
        "camelcase",
        "no-await-in-loop",
        "no-const-assign",
        "no-eval",
        "no-non-null-asserted-optional-chain",
        "no-non-null-assertion",
        "no-self-compare",
        "no-sync-fn-in-async-fn",
        "no-throw-literal",
        "no-useless-rename"
      ]
    },
    "exclude": [
      ".dist"
    ],
    "plugins": [
      "jsr:@zanix/utils@^4.0.0/linter/deno-zanix-plugin"
    ],
    "report": "pretty"
  },
  "fmt": {
    "exclude": [
      ".dist"
    ],
    "proseWrap": "always",
    "indentWidth": 2,
    "singleQuote": true,
    "lineWidth": 100,
    "useTabs": false,
    "semiColons": false
  },
  "imports": {
    "redis": "npm:redis@^5.9.0",
    "mongoose": "npm:mongoose@^8",
    "sqlite3": "jsr:@db/sqlite@^0.12.0",
    "@aws-sdk/client-s3": "npm:@aws-sdk/client-s3@^3.700.0",
    "@std/assert": "jsr:@std/assert@0.224",
    "@std/path": "jsr:@std/path@0.224",
    "@zanix/workers": "jsr:@zanix/utils@^4.0.0/workers",
    "@zanix/errors": "jsr:@zanix/utils@^4.0.0/errors",
    "@zanix/logger": "jsr:@zanix/utils@^4.0.0/logger",
    "@zanix/types": "jsr:@zanix/utils@^4.0.0/types",
    "@zanix/helpers": "jsr:@zanix/utils@^4.0.0/helpers",
    "@zanix/validator": "jsr:@zanix/utils@^4.0.0/validator",
    "@zanix/server": "jsr:@zanix/server@^4.0.0",
    "modules/": "./src/modules/",
    "shared/": "./src/shared/",
    "typings/": "./src/typings/",
    "utils/": "./src/utils/",
    "cache/": "./src/modules/cache/",
    "qlru/": "./src/modules/cache/qlru/",
    "database/": "./src/modules/database/",
    "mongo/": "./src/modules/database/providers/mongo/",
    "sqlite/": "./src/modules/database/providers/sqlite/",
    "observability/": "./src/modules/observability/",
    "dlq/": "./src/modules/dlq/",
    "storage/": "./src/modules/storage/",
    "files/": "./src/modules/files/"
  },
  "exports": {
    ".": "./mod.ts",
    "./database": "./src/modules/database/mod.ts",
    "./cache": "./src/modules/cache/mod.ts",
    "./cache/types": "./src/modules/cache/typings/mod.ts",
    "./observability": "./src/modules/observability/mod.ts",
    "./core": "./src/modules/core.ts",
    "./sqlite": "./src/modules/database/sqlite.ts",
    "./triggers-api": "./src/modules/triggers/triggers-api/mod.ts",
    "./triggers-api/rtos": "./src/modules/triggers/triggers-api/rtos/mod.ts",
    "./dlq": "./src/modules/dlq/mod.ts",
    "./dlq-api": "./src/modules/dlq/dlq-api/mod.ts",
    "./dlq-api/rtos": "./src/modules/dlq/dlq-api/rtos/mod.ts",
    "./storage": "./src/modules/storage/mod.ts",
    "./files": "./src/modules/files/mod.ts"
  },
  "nodeModulesDir": "auto",
  "publish": {
    "exclude": [
      ".github",
      "src/@tests"
    ]
  },
  "test": {
    "include": [
      "src/@tests/**/*.test.ts"
    ]
  },
  "zanix": {
    "project": "library",
    "hash": "pn287r"
  }
}
