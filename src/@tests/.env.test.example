# Copy this file to `.env.test` (gitignored) to enable the tests in
# src/@tests/functional/observability/connector-real.test.ts, which run against a REAL local
# Elasticsearch/OpenSearch instance instead of a mocked `fetch`. Skipped by default.
#
# 1. Start a local single-node OpenSearch with Docker:
#
#      docker run -d --name zanix-opensearch-test \
#        -p 9200:9200 -p 9600:9600 \
#        -e "discovery.type=single-node" \
#        -e "DISABLE_SECURITY_PLUGIN=true" \
#        -e "OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m" \
#        opensearchproject/opensearch:2
#
# 2. Copy this file: cp .env.test.example .env.test
# 3. Run: deno test --allow-all src/@tests/functional/observability/
#
# See docs/OBSERVABILITY.md#testing-against-a-real-local-cluster for more.

RUN_OPENSEARCH_TESTS=true

# Mongo URI connection
MONGO_URI=